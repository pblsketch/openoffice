-    let absorbed = spacing_before;
     // 다음 문단의 저장 첫 줄이 이 쪽 커서 기준으로 앞 간격 소비량(0..=앞 간격)을 증언하면 그
     // 값을 쓴다. 증언 범위 밖의 vpos(구역·쪽 경계 되감기 등)면 위 규칙을 그대로 쓴다.
     let stored_consumption = stored_layout
@@ -10141,4 +10181,77 @@ mod tests {
             Some(&next),
         ));
