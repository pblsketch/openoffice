+/// 글 없는 host 의 문단 기준 자리차지 표(세로 오프셋 0)가 없다고 볼 때 다음 문단이 시작할
+/// 자리 — host 문단 위끝(표 바깥 상자 위끝) + host 앞 간격 + 첫 저장 줄(줄높이 + 줄간격) +
+/// host 뒤 간격. 저장 줄이 없으면 `None`.
+pub(crate) fn empty_host_float_natural_successor_top(
+    host_top: f64,
+    host: &Paragraph,
+    styles: &crate::renderer::style_resolver::ResolvedStyleSet,
+    dpi: f64,
+) -> Option<f64> {
+    let line = host.line_segs.first().filter(|line| {
+        line.tag & crate::model::paragraph::LineSeg::TAG_IMPLEMENTATION_PROPERTY == 0
+            && line.line_height > 0
+    })?;
+    let style = styles.para_styles.get(host.para_shape_id as usize);
+    let before = style.map_or(0.0, |style| style.spacing_before).max(0.0);
+    let after = style.map_or(0.0, |style| style.spacing_after).max(0.0);
+    Some(
+        host_top
+            + before
+            + hwpunit_to_px(line.line_height, dpi)
+            + hwpunit_to_px(line.line_spacing.max(0), dpi)
+            + after,
+    )
+}
+
 /// [#8149] 글 없는 host 의 문단 기준 자리차지 표 상자 바로 뒤 문단은 한/글이 앞 간격을 그
 /// 표의 바깥 아래 여백 안에서 소비한다 — 다음 글줄이 상자 바닥에 놓인다. 저장 사다리가 상자를
 /// 인증하면 `stored_frame_successor_shared_spacing_px` 가 같은 일을 하므로, 이 함수는 인증
@@ -3939,12 +3964,14 @@ pub(crate) fn empty_host_float_successor_absorbed_spacing_px(
     hwpx_container: bool,
