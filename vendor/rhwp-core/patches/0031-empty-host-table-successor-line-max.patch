         return 0.0;
     }
+    let whole_table = matches!(previous_item, Some(PageItem::Table { .. }));
     let (owner, control_index) = match previous_item {
         Some(PageItem::Table {
             para_index,
@@ -4009,10 +4036,23 @@ pub(crate) fn empty_host_float_successor_absorbed_spacing_px(
         return 0.0;
     }
     let outer_bottom = hwpunit_to_px(i32::from(table.outer_margin_bottom), dpi).max(0.0);
-    if spacing_before > outer_bottom {
+    let absorbed = if spacing_before <= outer_bottom {
+        spacing_before
+    } else if let Some(natural_top) = natural_successor_top.filter(|_| whole_table) {
+        // 한 쪽에 통째로 놓인 표는 한/글이 다음 문단을 먼저 제자리(host 줄 뒤 + 앞 간격)에
+        // 놓아 보고, 그 줄이 표 띠에 걸리면 띠 끝으로 내린다 — 첫 줄 top 은
+        // `max(제자리 + 앞 간격, 띠 끝)` 이다. 앞 간격이 바깥 아래 여백보다 커도 같다.
+        // 한/글 2024 Print(도구가 만든 HWPX 서식, 다음 문단 앞 간격만 바꾼 변형):
+        // 앞 간격 0~53.3px 는 표 아래 글줄이 모두 같은 자리이고, 60px·80px 는 제자리
+        // + 앞 간격이 띠 끝을 넘은 만큼(5.8px·25.8px) 내려간다. 쪽을 넘어 이어진 조각
+        // 뒤(위 `PartialTable`)는 이 제자리가 없어 종전 규칙을 쓴다.
+        (flow_from_body_top - natural_top).clamp(0.0, spacing_before)
+    } else {
