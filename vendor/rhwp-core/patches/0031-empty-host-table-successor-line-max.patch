+
+    /// 한/글 2024 Print 측정(도구가 만든 서식의 빈 host 표 뒤 문단 앞 간격만 바꾼 변형)을 수로
+    /// 옮긴 관계: 제자리(host 줄 뒤)에서 앞 간격을 더한 줄이 띠 끝 위면 띠 끝에 서고, 넘으면
+    /// 넘은 만큼만 내려간다. 바깥 아래 여백 이하의 앞 간격은 종전 규칙이다.
+    #[test]
+    fn whole_empty_host_table_successor_line_is_max_of_natural_and_band_end() {
+        use crate::renderer::pagination::PageItem;
+        let table = Table {
+            common: CommonObjAttr {
+                height: 1_023,
+                ..base_common()
+            },
+            outer_margin_top: 283,
+            outer_margin_bottom: 283,
+            row_count: 3,
+            ..Default::default()
+        };
+        let host = Paragraph {
+            controls: vec![Control::Table(Box::new(table))],
+            line_segs: vec![LineSeg {
+                vertical_pos: 26_235,
+                line_height: 1_000,
+                text_height: 1_000,
+                line_spacing: 152,
+                ..Default::default()
+            }],
+            ..Default::default()
+        };
+        let next = Paragraph {
+            line_segs: vec![LineSeg {
+                vertical_pos: 27_787,
+                line_height: 1_000,
+                line_spacing: 152,
+                ..Default::default()
+            }],
+            ..Default::default()
+        };
+        let paragraphs = vec![host, next];
+        let whole = PageItem::Table {
+            para_index: 0,
+            control_index: 0,
+        };
+        let styles = crate::renderer::style_resolver::ResolvedStyleSet::default();
+        // 앞 간격 없는 host: 제자리 = 위끝 + 줄높이 + 줄간격.
+        let natural =
+            empty_host_float_natural_successor_top(344.5, &paragraphs[0], &styles, 96.0).unwrap();
+        assert!((natural - (344.5 + 1_000.0 / 75.0 + 152.0 / 75.0)).abs() < 1e-9);
+        let band_end = 419.3;
+        let absorbed = |item: &PageItem, before: f64, natural: Option<f64>| {
+            empty_host_float_successor_absorbed_spacing_px(
+                Some(item),
+                &paragraphs,
+                1,
+                before,
+                false,
+                true,
+                false,
+                band_end,
+                natural,
+                96.0,
+            )
+        };
+        // 앞 간격 5.3px(> 바깥 아래 여백 3.8px): 제자리 + 앞 간격이 띠 안이라 전부 흡수한다.
+        assert!((absorbed(&whole, 400.0 / 75.0, Some(natural)) - 400.0 / 75.0).abs() < 1e-9);
+        // 앞 간격 60px: 띠 끝을 넘은 만큼만 남는다(흡수 = 띠 끝 − 제자리).
+        assert!((absorbed(&whole, 60.0, Some(natural)) - (band_end - natural)).abs() < 1e-9);
+        // 제자리가 이미 띠 끝 아래면 흡수하지 않는다.
+        assert_eq!(absorbed(&whole, 60.0, Some(band_end + 1.0)), 0.0);
+        // 제자리를 모르면 종전대로 흡수하지 않는다.
+        assert_eq!(absorbed(&whole, 400.0 / 75.0, None), 0.0);
+        // 바깥 아래 여백 이하 앞 간격은 종전처럼 전부 흡수한다.
+        assert!((absorbed(&whole, 3.0, None) - 3.0).abs() < 1e-9);
+    }
 }
