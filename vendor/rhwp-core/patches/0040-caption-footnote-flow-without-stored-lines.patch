 pub fn estimate_footnote_note_height(footnote: &Footnote, dpi: f64) -> f64 {
+    // 줄이 모두 엔진이 만든 것(저장 줄 없는 XML 각주를 로드 때 나눈 줄, bit31)이면
+    // 한글이 정한 예약 높이가 아니다. 그리는 쪽(`layout_footnote_area`)처럼 줄 사이
+    // 간격까지 더해야 여러 줄 각주 위로 본문이 내려오지 않는다.
+    let synthetic = footnote.paragraphs.iter().any(|p| !p.line_segs.is_empty())
+        && footnote.paragraphs.iter().all(|p| {
+            p.line_segs
+                .iter()
+                .all(|s| s.tag & crate::model::paragraph::LineSeg::TAG_IMPLEMENTATION_PROPERTY != 0)
+        });
+    let total_lines: usize = footnote
+        .paragraphs
+        .iter()
+        .map(|p| p.line_segs.len().max(1))
+        .sum();
+    let mut line_index = 0usize;
     let mut height = 0.0;
     for para in &footnote.paragraphs {
         if para.line_segs.is_empty() {
             height += super::hwpunit_to_px(400, dpi);
+            line_index += 1;
         } else {
             for seg in &para.line_segs {
                 height += super::hwpunit_to_px(seg.line_height, dpi);
+                line_index += 1;
+                if synthetic && line_index < total_lines {
+                    height += super::hwpunit_to_px(seg.line_spacing, dpi);
+                }
             }
         }
     }
