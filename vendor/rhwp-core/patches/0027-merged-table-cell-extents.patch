+/// 칸들의 시작·끝 좌표(`extents`, 칸 순서 그대로)의 합집합을 새 격자선으로 삼아 각 칸의
+/// 열(행)과 걸침을 다시 매긴다. 크기는 부르는 쪽이 이미 고쳐 두었다.
+pub(crate) fn rebuild_axis_from_extents(
+    table: &mut crate::model::table::Table,
+    vertical: bool,
+    extents: &[(i64, i64)],
+) {
+    let mut set: std::collections::BTreeSet<i64> = std::collections::BTreeSet::new();
+    for &(s, e) in extents {
+        set.insert(s);
+        set.insert(e);
+    }
+    let lines: Vec<i64> = set.into_iter().collect();
+    let index = |x: i64| lines.partition_point(|&l| l < x) as u16;
+    for (cell, &(s, e)) in table.cells.iter_mut().zip(extents) {
+        let (a, b) = (index(s), index(e));
+        if vertical {
+            cell.row = a;
+            cell.row_span = (b - a).max(1);
+        } else {
+            cell.col = a;
+            cell.col_span = (b - a).max(1);
+        }
+    }
+    if vertical {
+        table.row_count = (lines.len().max(2) - 1) as u16;
+    } else {
+        table.col_count = (lines.len().max(2) - 1) as u16;
     }
+    table.cells.sort_by_key(|c| (c.row, c.col));
+    table.rebuild_grid();
+    table.rebuild_row_sizes();
 }
 
