+/// 축(가로면 열, 세로면 행)을 따라 각 칸이 놓인 시작·끝 좌표(HWPUNIT).
+///
+/// 격자선마다 좌표를 정한다 — 칸마다 `선[끝] = 선[시작] + 크기`. 좁은 칸부터 정해 합친 칸의
+/// 크기가 걸친 칸들의 합과 조금 어긋나도 격자는 한 벌로 맞춘다. 위 행에서 내려온 합친 칸도
+/// 좌표로 놓이므로, 행마다 크기를 누적하던 때처럼 그 자리를 다른 칸이 차지하지 않는다.
+/// 정할 수 없는 격자선이 남으면 `None`.
+pub(crate) fn cell_axis_extents(
+    table: &crate::model::table::Table,
+    vertical: bool,
+) -> Option<Vec<(i64, i64)>> {
+    let span_of = |c: &crate::model::table::Cell| {
+        if vertical {
+            (usize::from(c.row), usize::from(c.row_span.max(1)))
+        } else {
+            (usize::from(c.col), usize::from(c.col_span.max(1)))
+        }
+    };
+    let size_of =
+        |c: &crate::model::table::Cell| i64::from(if vertical { c.height } else { c.width });
+    let count = table
+        .cells
+        .iter()
+        .map(|c| {
+            let (s, n) = span_of(c);
+            s + n
+        })
+        .max()
+        .unwrap_or(0);
+    let mut lines: Vec<Option<i64>> = vec![None; count + 1];
+    lines[0] = Some(0);
+    let mut by_span: Vec<usize> = (0..table.cells.len()).collect();
+    by_span.sort_by_key(|&i| {
+        let (s, n) = span_of(&table.cells[i]);
+        (n, s)
+    });
+    for _ in 0..=count {
+        let mut grew = false;
+        for &i in &by_span {
+            let cell = &table.cells[i];
+            let (s, n) = span_of(cell);
+            match (lines[s], lines[s + n]) {
+                (Some(start), None) => {
+                    lines[s + n] = Some(start + size_of(cell));
+                    grew = true;
+                }
+                (None, Some(end)) => {
+                    lines[s] = Some(end - size_of(cell));
+                    grew = true;
+                }
+                _ => {}
+            }
+        }
+        if !grew {
+            break;
+        }
+    }
+    if lines.iter().any(|l| l.is_none()) {
+        return None;
+    }
+    Some(
+        table
+            .cells
+            .iter()
+            .map(|c| {
+                let (s, n) = span_of(c);
+                (lines[s].unwrap_or(0), lines[s + n].unwrap_or(0))
+            })
+            .collect(),
+    )
+}
