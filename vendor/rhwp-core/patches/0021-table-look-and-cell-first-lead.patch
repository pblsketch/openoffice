+/// 셀의 저장 높이가 첫 저장 줄의 아래끝도 담지 못하는가 — 문서 도구가 만든 HWPX는 셀
+/// 높이를 안 여백 정도(0~417HU)로 적고 줄은 그 아래로 저장한다. 한글이 저장한 셀은
+/// 선언이 적어도 첫 줄은 담는다(쪽에 걸쳐 나뉜 행은 마지막 줄이 선언을 조금 넘기도
+/// 하므로 전체 줄로 보지 않는다). 이런 셀의 저장 줄 위치는 재서 적은 값이 아니어서,
+/// 한글 2024는 첫 문단의 위 여백을 저장 위치와 상관없이 첫 줄 앞에 둔다.
+pub(crate) fn cell_declared_height_misses_first_line(
+    cell: &crate::model::table::Cell,
+    dpi: f64,
+) -> bool {
+    if cell.row_span != 1 {
+        return false;
+    }
+    let declared = if cell.height < 0x8000_0000 {
+        hwpunit_to_px(cell.height as i32, dpi)
+    } else {
+        0.0
+    };
+    cell.paragraphs
+        .first()
+        .filter(|para| !para_has_no_stored_line_segs(para))
+        .and_then(|para| para.line_segs.first())
+        .filter(|seg| seg.vertical_pos >= 0 && seg.line_height > 0)
+        .is_some_and(|seg| {
+            hwpunit_to_px(seg.vertical_pos.saturating_add(seg.line_height), dpi) > declared + 0.5
+        })
+}
+
+/// 위 셀에서 첫 문단의 위 여백 가운데 저장 첫 줄 위치가 담지 않은 몫(px). 셀 배치는
+/// 저장 위치까지만 첫 줄을 내리므로(`cell_first_para_stored_lead`) 남은 몫을 내용
+/// 높이와 첫 줄 위치에 함께 더한다. 그 밖의 셀은 0.
+pub(crate) fn cell_first_para_missing_lead(
+    cell: &crate::model::table::Cell,
+    spacing_before_px: f64,
+    dpi: f64,
+) -> f64 {
+    if spacing_before_px <= 0.0 || !cell_declared_height_misses_first_line(cell, dpi) {
+        return 0.0;
+    }
+    let vpos = cell
+        .paragraphs
+        .first()
+        .and_then(|para| para.line_segs.first())
+        .map(|seg| hwpunit_to_px(seg.vertical_pos, dpi))
+        .unwrap_or(0.0);
+    (spacing_before_px - vpos.max(0.0)).max(0.0)
+}
