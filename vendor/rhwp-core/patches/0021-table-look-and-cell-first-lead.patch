+/// 문단의 첫 위아래·문단 기준(글자처럼 취급하지 않는) 표가 문단 위끝에서 차지하는
+/// 띠의 끝(HWPUNIT): 세로 오프셋 + 바깥 위 여백 + 높이 + 바깥 아래 여백. 그런 표가
+/// 없거나 글자처럼 취급하는 개체가 함께 있으면 `None`.
+fn first_para_topbottom_table_band_end_hu(para: &Paragraph) -> Option<i32> {
+    if para.controls.iter().any(|control| match control {
+        Control::Shape(shape) => shape.common().treat_as_char,
+        Control::Picture(picture) => picture.common.treat_as_char,
+        Control::Table(table) => table.common.treat_as_char,
+        _ => false,
+    }) {
+        return None;
+    }
+    para.controls.iter().find_map(|control| match control {
+        Control::Table(table)
+            if matches!(
+                table.common.text_wrap,
+                crate::model::shape::TextWrap::TopAndBottom
+            ) && matches!(
+                table.common.vert_rel_to,
+                crate::model::shape::VertRelTo::Para
+            ) =>
+        {
+            let offset =
+                crate::renderer::float_placement::signed_hwpunit(table.common.vertical_offset)
+                    .max(0);
+            Some(
+                offset
+                    + table.common.height as i32
+                    + table.outer_margin_top as i32
+                    + table.outer_margin_bottom as i32,
+            )
+        }
+        _ => None,
+    })
