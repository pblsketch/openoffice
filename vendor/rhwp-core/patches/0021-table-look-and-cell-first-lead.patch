-        // (HWP 렌더링은 cell.border_fill_id를 사용, table.border_fill_id는 페이지 분할용)
+        // BorderFill 변경 — 표 테두리/대각선은 모든 셀에도 적용하고, 배경은 아래 규칙으로
+        // 셀에 퍼진다(한글은 table.border_fill_id의 채움도 셀 뒤에 칠한다).
         let has_border_fill_change = json.contains("\"borderLeft\"")
             || json.contains("\"fillType\"")
             || json.contains("\"diagonalLine\"")
@@ -3104,11 +3104,66 @@ impl DocumentCore {
             || json.contains("\"diagonalColor\"")
             || json.contains("\"centerLine\"");
         if has_border_fill_change {
-            let new_bf_id = self.create_border_fill_from_json(json);
+            // 표와 각 셀은 자기 테두리/배경에서 시작해 넘어온 항목만 바꾼다. 하나의 새
+            // BorderFill(빈 기본값 + 넘어온 항목)을 모두에 주면 배경만 바꿔도 셀마다 다른
+            // 선과 셀 배경(머리 칸의 색 등)이 지워진다. 배경은 표와 같은 채움이던 셀만
+            // 따라간다: 한글은 표 자체의 채움을 셀 뒤에 칠하므로 그런 셀은 표 배경으로
+            // 보이고, 자기 색을 가진 셀은 표 배경을 바꿔도 그대로다.
+            let fill_keys = ["fillType", "fillColor", "patternColor", "patternType"];
+            let has_line_change = json.contains("\"borderLeft\"")
+                || json.contains("\"borderRight\"")
+                || json.contains("\"borderTop\"")
+                || json.contains("\"borderBottom\"")
+                || json.contains("\"diagonalLine\"")
+                || json.contains("\"diagonalSlash\"")
+                || json.contains("\"diagonalBackSlash\"")
+                || json.contains("\"diagonalWidth\"")
+                || json.contains("\"diagonalColor\"")
+                || json.contains("\"centerLine\"");
+            let fill_of = |doc: &Self, id: u16| {
+                id.checked_sub(1)
+                    .and_then(|i| doc.document.doc_info.border_fills.get(i as usize))
+                    .map(|bf| bf.fill.clone())
+                    .unwrap_or_default()
+            };
+            let (table_bf_id, cell_bf_ids): (u16, Vec<u16>) = {
+                let table = self.get_table_mut(section_idx, parent_para_idx, control_idx)?;
+                (
+                    table.border_fill_id,
+                    table.cells.iter().map(|cell| cell.border_fill_id).collect(),
+                )
+            };
+            let table_fill = fill_of(self, table_bf_id);
+            let based_on = |doc: &mut Self, base: u16, with_fill: bool| {
+                if !with_fill && !has_line_change {
+                    return base;
+                }
+                let json = match serde_json::from_str::<serde_json::Value>(json) {
+                    Ok(serde_json::Value::Object(mut obj)) => {
+                        obj.insert("borderFillId".to_string(), serde_json::Value::from(base));
+                        if !with_fill {
+                            for key in fill_keys {
+                                obj.remove(key);
+                            }
+                        }
+                        serde_json::Value::Object(obj).to_string()
+                    }
+                    _ => json.to_string(),
+                };
+                doc.create_border_fill_from_json(&json)
+            };
+            let new_table_bf_id = based_on(self, table_bf_id, true);
+            let new_cell_bf_ids: Vec<u16> = cell_bf_ids
+                .iter()
+                .map(|&id| {
+                    let shows_table_fill = fill_of(self, id) == table_fill;
+                    based_on(self, id, shows_table_fill)
+                })
+                .collect();
             let table = self.get_table_mut(section_idx, parent_para_idx, control_idx)?;
-            table.border_fill_id = new_bf_id;
-            for cell in &mut table.cells {
-                cell.border_fill_id = new_bf_id;
+            table.border_fill_id = new_table_bf_id;
+            for (cell, id) in table.cells.iter_mut().zip(new_cell_bf_ids) {
+                cell.border_fill_id = id;
             }
         }
 
