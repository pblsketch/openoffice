 /// A non-TAC `TopAndBottom` object positioned from its host paragraph.
+/// 문서 도구가 표를 작게 가정하고 적은 저장 상자: 실제(측정) 높이가 선언 높이를 크게
+/// 넘는다(신고 문서: 선언 13.6px, 실제 67.3px). 이런 표 뒤의 저장 줄 위치는 작은 표를
+/// 전제로 적힌 낡은 값이라 vpos 보정이 거절하고, 흐름은 아래 몫으로 이어야 한다.
+/// 측정 오차 정도의 차이(한글이 저장한 표)는 걸리지 않게 배수와 절대 차를 함께 요구한다.
+pub(crate) fn table_outgrew_stored_height(
+    table: &crate::model::table::Table,
+    host: &crate::model::paragraph::Paragraph,
+    next: Option<&crate::model::paragraph::Paragraph>,
+    measured_px: f64,
+    dpi: f64,
+) -> bool {
+    let declared = hwpunit_to_px(signed_hwpunit(table.common.height), dpi).max(0.0);
+    if !(measured_px > declared * 1.5 && measured_px > declared + 10.0) {
+        return false;
+    }
+    // 저장 사다리가 표를 담지 않았다는 증거: 같은 쪽에서 다음 문단의 저장 줄이
+    // 호스트 줄보다 아래지만, 그 거리가 그린 표 높이보다 짧다(신고 문서: 1552HU =
+    // 호스트 한 줄 + 다음 앞 간격). 한글이 저장한 사다리는 표 상자를 담는다.
+    let stored = |p: &crate::model::paragraph::Paragraph| {
+        p.line_segs
+            .first()
+            .filter(|seg| seg.tag & crate::model::paragraph::LineSeg::TAG_IMPLEMENTATION_PROPERTY == 0)
+            .map(|seg| seg.vertical_pos)
+    };
+    let (Some(host_vpos), Some(next_vpos)) = (stored(host), next.and_then(stored)) else {
+        return false;
+    };
+    next_vpos > host_vpos && hwpunit_to_px(next_vpos - host_vpos, dpi) + 0.5 < measured_px
+}
+
+/// 위 표가 든 빈 문단 뒤 문단의 첫 줄은 한글에서 표 바깥 상자의 아래끝에서 시작한다.
+/// 표가 그려진 아래끝에 더할 몫(px): 바깥 아래 여백 − 다음 문단 앞 간격(다음 문단이
+/// 자기 앞 간격을 다시 더한다). 음수일 수 있다.
+pub(crate) fn outgrown_table_flow_extras_px(
+    table: &crate::model::table::Table,
+    next_spacing_before: f64,
+    dpi: f64,
+) -> f64 {
+    hwpunit_to_px(i32::from(table.outer_margin_bottom), dpi) - next_spacing_before.max(0.0)
+}
+
