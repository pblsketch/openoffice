-    if tail_allowance.allowed {
+    // 저장 사다리가 이 문단을 다음 쪽 위에서 다시 시작했으면(되감김 + 전체 배치 실패)
+    // 한/글은 이 문단으로 새 쪽을 열었다. 그 쪽이 짧아도 꼬리 넘침으로 끌어오지 않는다.
+    if tail_allowance.allowed && !stored_vpos_rewind_overflow_break {
