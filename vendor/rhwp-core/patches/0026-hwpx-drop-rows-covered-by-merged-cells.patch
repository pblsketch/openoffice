+/// HWPX에 내보낼 행. 위 행에서 합친 칸이 덮을 뿐 시작하는 칸이 없는 행은 뺀다.
+///
+/// 칸을 세로로 합치면 모델에는 시작하는 칸이 없는 행이 남는다(.hwp는 행마다 칸 수를
+/// 적으므로 그 행의 칸 수 0으로 그대로 저장된다). HWPX에서 이 행은 빈 `<hp:tr>`이 되는데,
+/// 한컴 한글은 이런 파일을 "파일을 읽거나 저장하는데 오류가 있습니다"로 열지 않는다.
+/// 한컴이 저장한 HWPX에는 이런 행이 없다. 그래서 그 행을 빼고 행 번호(`rowAddr`,
+/// 셀 영역)를 당기며, 걸쳐 있던 칸의 `rowSpan`을 줄인다. 합친 칸의 높이(`cellSz`)에는
+/// 이미 뺀 행의 높이가 들어 있으므로 표 모양은 같다. 모든 행에 시작하는 칸이 있으면
+/// 번호는 그대로다.
+struct HwpxRows {
+    row_count: u16,
+    /// 원래 행 번호 → 그 행까지(포함) 남는 행 수. 비면 모든 행이 남는다.
+    kept_through: Vec<u16>,
+}
+
+impl HwpxRows {
+    fn new(table: &Table) -> Self {
+        let n = table.row_count as usize;
+        let mut starts = vec![false; n];
+        for cell in &table.cells {
+            if let Some(s) = starts.get_mut(cell.row as usize) {
+                *s = true;
+            }
+        }
+        if starts.iter().all(|&s| s) {
+            return Self {
+                row_count: table.row_count,
+                kept_through: Vec::new(),
+            };
+        }
+        let mut kept = 0u16;
+        let kept_through = starts
+            .iter()
+            .map(|&s| {
+                if s {
+                    kept += 1;
+                }
+                kept
+            })
+            .collect();
+        Self {
+            row_count: table.row_count,
+            kept_through,
+        }
+    }
+
+    fn is_kept(&self, row: u16) -> bool {
+        if self.kept_through.is_empty() {
+            return true;
+        }
+        let r = row as usize;
+        let before = if r == 0 { 0 } else { self.kept_through[r - 1] };
+        self.kept_through.get(r).is_some_and(|&k| k > before)
+    }
+
+    fn count(&self) -> u16 {
+        self.kept_through.last().copied().unwrap_or(self.row_count)
+    }
+
+    /// 원래 행 번호의 새 번호. 뺀 행이면 그 행을 덮는 위쪽 남은 행의 번호다.
+    fn addr(&self, row: u16) -> u16 {
+        if self.kept_through.is_empty() {
+            return row;
+        }
+        let last = self.kept_through.len() - 1;
+        let k = self.kept_through[(row as usize).min(last)];
+        k.saturating_sub(1)
+    }
+
+    /// `row`에서 시작해 `span`행에 걸친 칸이 남는 행 몇 개에 걸치는지.
+    fn span(&self, row: u16, span: u16) -> u16 {
+        if self.kept_through.is_empty() {
+            return span;
+        }
+        let last = row.saturating_add(span).saturating_sub(1);
+        let kept = self.addr(last).saturating_sub(self.addr(row)) + 1;
+        kept.max(1)
+    }
+}
