+    /// 세로로 합친 칸만 덮는 행(시작하는 칸이 없는 행)은 빈 `<hp:tr>`로 내보내지 않는다.
+    /// 한컴 한글은 빈 `<hp:tr>`이 든 HWPX를 열지 못한다. 1열 표의 아래 세 칸을 합친
+    /// 서면 질의서 답변 표에서 나왔다.
+    #[test]
+    fn rows_only_covered_by_merged_cells_are_dropped() {
+        let mut t = empty_table(4, 1);
+        t.merge_cells(1, 0, 3, 0).expect("병합");
+        assert_eq!(t.row_count, 4, "모델의 행 수는 그대로");
+        let xml = serialize(&t);
+        assert!(!xml.contains("<hp:tr></hp:tr>"), "빈 tr: {xml}");
+        assert!(xml.contains(r#"rowCnt="2""#), "rowCnt: {xml}");
+        assert_eq!(xml.matches("<hp:tr>").count(), 2);
+        assert!(
+            xml.contains(r#"<hp:cellAddr colAddr="0" rowAddr="1"/><hp:cellSpan colSpan="1" rowSpan="1"/><hp:cellSz width="1000" height="900"/>"#),
+            "합친 칸은 1행에서 한 행, 높이는 세 행 합: {xml}"
+        );
+    }
+
+    /// 빠진 행 아래의 칸과 셀 영역은 번호를 당긴다. 다른 열이 여전히 그 행을 쓰면 빼지 않는다.
+    #[test]
+    fn rows_below_dropped_rows_are_renumbered() {
+        use crate::model::table::TableZone;
+        // 2열 5행. 두 열 모두 1~2행을 합쳐 2행이 비고, 왼쪽 열만 3~4행을 합친다.
+        let mut t = empty_table(5, 2);
+        t.merge_cells(1, 0, 2, 1).expect("1~2행 병합");
+        t.merge_cells(3, 0, 4, 0).expect("왼쪽 3~4행 병합");
+        t.zones.push(TableZone {
+            start_row: 2,
+            start_col: 0,
+            end_row: 4,
+            end_col: 1,
+            border_fill_id: 5,
+        });
+        let xml = serialize(&t);
+        assert!(xml.contains(r#"rowCnt="4""#), "rowCnt: {xml}");
+        assert_eq!(xml.matches("<hp:tr>").count(), 4);
+        assert!(!xml.contains("<hp:tr></hp:tr>"), "빈 tr: {xml}");
+        assert!(
+            xml.contains(
+                r#"<hp:cellAddr colAddr="0" rowAddr="1"/><hp:cellSpan colSpan="2" rowSpan="1"/>"#
+            ),
+            "1~2행 병합 칸: {xml}"
+        );
+        assert!(
+            xml.contains(
+                r#"<hp:cellAddr colAddr="0" rowAddr="2"/><hp:cellSpan colSpan="1" rowSpan="2"/>"#
+            ),
+            "왼쪽 3~4행 병합 칸: {xml}"
+        );
+        assert!(
+            xml.contains(
+                r#"<hp:cellAddr colAddr="1" rowAddr="3"/><hp:cellSpan colSpan="1" rowSpan="1"/>"#
+            ),
+            "오른쪽 4행 칸: {xml}"
+        );
+        assert!(
+            xml.contains(r#"<hp:cellzone startRowAddr="1" startColAddr="0" endRowAddr="3" endColAddr="1" borderFillIDRef="5"/>"#),
+            "셀 영역: {xml}"
+        );
+    }
+
+    /// 빼고 쓴 HWPX를 다시 읽으면 칸 배치와 크기가 같다.
+    #[test]
+    fn dropped_rows_roundtrip_to_same_cells() {
+        use crate::model::control::Control;
+
+        let bytes0 = std::fs::read("samples/hwpx/basic-table-01.hwpx").expect("샘플 읽기");
+        let mut doc = crate::parser::hwpx::parse_hwpx(&bytes0).expect("샘플 파싱");
+        let mut merged = None;
+        'find: for section in &mut doc.sections {
+            for para in &mut section.paragraphs {
+                for control in &mut para.controls {
+                    if let Control::Table(table) = control {
+                        if table.row_count >= 3 {
+                            let last = table.col_count - 1;
+                            table.merge_cells(1, 0, 2, last).expect("병합");
+                            merged = Some(table.clone());
+                            break 'find;
+                        }
+                    }
+                }
+            }
+        }
+        let before = merged.expect("3행 이상 표");
+        let bytes = crate::serializer::hwpx::serialize_hwpx(&doc).expect("직렬화");
+        let doc2 = crate::parser::hwpx::parse_hwpx(&bytes).expect("재파싱");
+        let after = doc2
+            .sections
+            .iter()
+            .flat_map(|s| &s.paragraphs)
+            .flat_map(|p| &p.controls)
+            .find_map(|c| match c {
+                Control::Table(t) if t.common.width == before.common.width => Some(t),
+                _ => None,
+            })
+            .expect("다시 읽은 표");
+        assert_eq!(after.row_count, before.row_count - 1);
+        assert_eq!(after.cells.len(), before.cells.len());
+        let key = |t: &Table| {
+            let mut v: Vec<_> = t
+                .cells
+                .iter()
+                .map(|c| (c.col, c.col_span, c.width, c.height))
+                .collect();
+            v.sort();
+            v
+        };
+        assert_eq!(key(after), key(&before));
+    }
 }
