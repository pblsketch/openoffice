+/// 종이·쪽 기준 자리차지(TopAndBottom) 도형·그림을 앵커한 문단이 그 개체 밴드
+/// 안에서 시작하면, 그리는 쪽은 앵커 문단부터 개체 아래로 내린다(layout
+/// `calculate_shape_reserved_heights` 와 `shape_jumped`). 저장 사다리가 개체를
+/// 계상하지 않은 문서(개체 안쪽에 앵커 줄을 저장)는 typeset 이 저장 위치를 그대로
+/// 따라가 두 흐름이 갈라진다 — 뒤 글자처럼 취급 표는 typeset 이 확정한 자리에
+/// 그려져 내려간 제목 줄 위에 겹치고, 쪽 끝 줄은 본문 아래로 넘친다. 한글 2024 도
+/// 앵커 문단부터 개체 아래에 놓고 넘친 줄을 다음 쪽으로 보낸다.
+///
+/// 그리는 쪽과 같은 개체·같은 판정을 쓴다: 비-TAC 도형·그림, 수평으로 단과 겹침,
+/// 개체 위끝이 단 위 1/3 안, 앵커 문단 글이 개체 위에 들어가면 내리지 않음.
+/// `flow_y` 와 돌려주는 값은 단 상단 기준 px 이다. 이미 개체 아래면 `None`.
+pub(crate) fn topbottom_float_anchor_flow_bottom(
+    para: &Paragraph,
+    anchor_text_height: f64,
+    flow_y: f64,
+    col: &crate::renderer::page_layout::LayoutRect,
+    body: &crate::renderer::page_layout::LayoutRect,
+    dpi: f64,
+) -> Option<f64> {
+    use crate::model::shape::{HorzAlign, HorzRelTo, TextWrap, VertAlign, VertRelTo};
+    // layout `calc_shape_bottom_y` 와 같은 (아래끝, 위끝).
+    let geometry = |common: &crate::model::shape::CommonObjAttr| -> (f64, f64) {
+        let v_offset = hwpunit_to_px(common.vertical_offset as i32, dpi);
+        let shape_h = hwpunit_to_px(common.height as i32, dpi);
+        let (ref_y, ref_h) = match common.vert_rel_to {
+            VertRelTo::Paper => (0.0_f64, body.y + body.height + body.y),
+            VertRelTo::Page => (body.y, body.height),
+            VertRelTo::Para => (col.y, col.height),
+        };
+        let top = match common.vert_align {
+            VertAlign::Top | VertAlign::Inside => ref_y + v_offset,
+            VertAlign::Center => ref_y + (ref_h - shape_h) / 2.0 + v_offset,
+            VertAlign::Bottom | VertAlign::Outside => ref_y + ref_h - shape_h - v_offset,
+        };
+        let margin_bottom = hwpunit_to_px(common.margin.bottom as i32, dpi);
+        (top + shape_h + margin_bottom, top)
+    };
+    // layout `check_horizontal_overlap` 과 같다.
+    let overlaps_column = |common: &crate::model::shape::CommonObjAttr| -> bool {
+        let h_offset = hwpunit_to_px(common.horizontal_offset as i32, dpi);
+        let shape_w = hwpunit_to_px(common.width as i32, dpi);
+        let (ref_x, ref_w) = match common.horz_rel_to {
+            HorzRelTo::Paper => (0.0_f64, body.x + body.width + body.x),
+            HorzRelTo::Page => (body.x, body.width),
+            _ => (col.x, col.width),
+        };
+        let x = match common.horz_align {
+            HorzAlign::Left | HorzAlign::Inside => ref_x + h_offset,
+            HorzAlign::Center => ref_x + (ref_w - shape_w) / 2.0 + h_offset,
+            HorzAlign::Right | HorzAlign::Outside => ref_x + ref_w - shape_w - h_offset,
+        };
+        x + shape_w >= col.x && x <= col.x + col.width
+    };
+    fn float_common(ctrl: &Control) -> Option<&crate::model::shape::CommonObjAttr> {
+        match ctrl {
+            Control::Shape(s) if !s.common().treat_as_char => Some(s.common()),
+            Control::Picture(p) if !p.common.treat_as_char => Some(&p.common),
+            _ => None,
+        }
+    }
+    let bottom = para
+        .controls
+        .iter()
+        .filter_map(float_common)
+        .filter(|common| {
+            matches!(common.text_wrap, TextWrap::TopAndBottom)
+                && !matches!(common.vert_rel_to, VertRelTo::Para)
+                && overlaps_column(common)
+        })
+        .map(geometry)
+        .filter(|&(_, top)| top <= col.y + col.height / 3.0)
+        .map(|(bottom, _)| bottom)
+        .reduce(f64::max)?;
+    let y = col.y + flow_y;
+    if bottom <= y {
+        return None;
+    }
+    // 그리는 쪽은 앵커의 첫 자리차지 개체 위끝으로 "개체 위에 들어감"을 잰다.
+    let first_top = para
+        .controls
+        .iter()
+        .filter_map(float_common)
+        .find(|common| matches!(common.text_wrap, TextWrap::TopAndBottom))
+        .map(|common| geometry(common).1);
+    if first_top.is_some_and(|top| anchor_text_height + 4.0 <= top - y) {
+        return None;
+    }
+    Some(bottom - col.y)
+}
+
+/// 저장 사다리가 종이·쪽 기준 자리차지 개체를 계상하지 않은 첫 앵커 문단 — 그 문단의 저장
+/// 첫 줄이 자기 개체 밴드 안에 있다(`topbottom_float_anchor_flow_bottom` 이 내릴 자리).
+/// 한글 2024 는 이 문단부터 다시 조판하므로 그 뒤의 저장 쪽 경계·되감김은 다른 조판의 것이다.
+/// 저장 줄이 쪽마다 되감기지 않는 사다리(누적 좌표)는 줄이 개체 밴드에 들지 않아 해당하지 않는다.
+pub(crate) fn first_stale_topbottom_float_anchor(
+    paragraphs: &[Paragraph],
+    col: &crate::renderer::page_layout::LayoutRect,
+    body: &crate::renderer::page_layout::LayoutRect,
+    dpi: f64,
+) -> Option<usize> {
+    paragraphs.iter().position(|para| {
+        if !para
+            .controls
+            .iter()
+            .any(|ctrl| matches!(ctrl, Control::Shape(_) | Control::Picture(_)))
+        {
+            return false;
+        }
+        let mut stored = para
+            .line_segs
+            .iter()
+            .filter(|seg| !is_synthetic_line_seg(seg));
+        let Some(first) = stored.next() else {
+            return false;
+        };
+        let text_height: f64 = std::iter::once(first)
+            .chain(stored)
+            .map(|seg| hwpunit_to_px(seg.line_height + seg.line_spacing, dpi))
+            .sum();
+        topbottom_float_anchor_flow_bottom(
+            para,
+            text_height,
+            hwpunit_to_px(first.vertical_pos, dpi),
+            col,
+            body,
+            dpi,
+        )
+        .is_some()
+    })
+}
