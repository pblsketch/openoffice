+    /// (`layout_caption` 호출부), 각주는 본문 영역 폭(`compose_footnote_paragraph`).
+    /// 합성 줄은 bit31 표식이라 HWPX 저장 때 방출되지 않는다(#5847). `.hwp` 에는 실린다 —
+    /// HWP5 는 열 때 본문의 빈 줄을 만들지 않으므로, 그 줄이 있어야 다시 연 문서도 같다.
+    fn reflow_caption_and_footnote_paragraphs(
+        para: &mut Paragraph,
+        body_width: f64,
+        styles: &ResolvedStyleSet,
+        dpi: f64,
+    ) {
+        use crate::model::shape::CaptionDirection;
+        let needs = |p: &Paragraph| p.line_segs.is_empty() && !p.text.is_empty();
+        let reflow_caption = |caption: &mut Option<crate::model::shape::Caption>,
+                              object_width: u32| {
+            let Some(caption) = caption else {
+                return;
+            };
+            let width_hu = match caption.direction {
+                CaptionDirection::Top | CaptionDirection::Bottom => object_width,
+                CaptionDirection::Left | CaptionDirection::Right => caption.width,
+            };
+            let width = crate::renderer::hwpunit_to_px(width_hu as i32, dpi);
+            if width <= 0.0 {
+                return;
+            }
+            for cap_para in &mut caption.paragraphs {
+                if needs(cap_para) {
+                    let style = styles.para_styles.get(cap_para.para_shape_id as usize);
+                    reflow_line_segs(
+                        cap_para,
+                        ParagraphBox::content_for_style(width, style, dpi),
+                        styles,
+                        dpi,
+                    );
+                }
+            }
+            // 문단마다 0 에서 시작한 합성 줄 위치를 캡션 목록 전체로 잇는다. 한글이
+            // 저장한 캡션 줄 위치는 목록 위끝 기준으로 이어지고, `caption_height_px` 는
+            // 그 끝을 캡션 높이로 읽는다. 잇지 않으면 "[그림 n] 제목" + "주: …" 처럼
+            // 문단이 둘인 캡션이 가장 긴 문단 하나 높이만 예약해 아래 글과 겹친다.
+            let all_synthetic = caption.paragraphs.iter().all(|p| {
+                !p.line_segs.is_empty()
+                    && p.line_segs.iter().all(|s| {
+                        s.tag & crate::model::paragraph::LineSeg::TAG_IMPLEMENTATION_PROPERTY != 0
+                    })
+            });
+            if all_synthetic && caption.paragraphs.len() > 1 {
+                let to_hu = |px: f64| crate::renderer::px_to_hwpunit(px, dpi);
+                let mut running = 0i32;
+                for cap_para in &mut caption.paragraphs {
+                    let style = styles.para_styles.get(cap_para.para_shape_id as usize);
+                    running += style.map_or(0, |s| to_hu(s.spacing_before));
+                    let shift = running - cap_para.line_segs[0].vertical_pos;
+                    for seg in &mut cap_para.line_segs {
+                        seg.vertical_pos += shift;
+                    }
+                    let last = cap_para.line_segs.last().expect("non-empty");
+                    running = last.vertical_pos
+                        + last.line_height
+                        + last.line_spacing
+                        + style.map_or(0, |s| to_hu(s.spacing_after));
+                }
+            }
+        };
+        let control_lines: Vec<Option<usize>> = (0..para.controls.len())
+            .map(|index| crate::renderer::layout::control_line_seg_index(para, index))
+            .collect();
+        let mut picture_line_heights: Vec<(usize, i32)> = Vec::new();
+        for (index, control) in para.controls.iter_mut().enumerate() {
+            match control {
+                Control::Picture(picture) => {
+                    reflow_caption(&mut picture.caption, picture.common.width);
+                    if picture.common.treat_as_char {
+                        let extent =
+                            crate::renderer::composer::tac_picture_caption_extent_hwp(picture);
+                        if let (Some(line), true) = (control_lines[index], extent > 0) {
+                            picture_line_heights
+                                .push((line, picture.common.height as i32 + extent));
+                        }
+                    }
+                }
+                Control::Shape(shape) => {
+                    let width = shape.common().width;
+                    if let Some(drawing) = shape.drawing_mut() {
+                        reflow_caption(&mut drawing.caption, width);
+                    }
+                }
+                Control::Table(table) => {
+                    reflow_caption(&mut table.caption, table.common.width);
+                    for cell in &mut table.cells {
+                        for cell_para in &mut cell.paragraphs {
+                            Self::reflow_caption_and_footnote_paragraphs(
+                                cell_para, body_width, styles, dpi,
+                            );
+                        }
+                    }
+                }
+                Control::Footnote(footnote) => {
+                    for note_para in &mut footnote.paragraphs {
+                        if !needs(note_para) {
+                            continue;
+                        }
+                        let style = styles.para_styles.get(note_para.para_shape_id as usize);
+                        let margin_left = style.map(|s| s.margin_left).unwrap_or(0.0);
+                        let margin_right = style.map(|s| s.margin_right).unwrap_or(0.0);
+                        let width = (body_width - margin_left - margin_right).max(0.0);
+                        if width > 0.0 {
+                            reflow_line_segs(
+                                note_para,
+                                ParagraphBox::content_width_px(width, dpi),
+                                styles,
+                                dpi,
+                            );
+                        }
+                    }
+                }
+                _ => {}
+            }
+        }
+        // 엔진이 만든 그림 줄(bit31)이 캡션을 빼고 그림 높이만 가진 경우(예전 엔진이 줄 정보
+        // 없는 HWPX 를 `.hwp` 로 바꾼 파일)는 한글이 저장하는 높이(그림 + 간격 + 캡션)로
+        // 바로잡는다. 한글이 저장한 줄은 건드리지 않는다.
+        for (line, needed) in picture_line_heights {
+            if let Some(seg) = para.line_segs.get_mut(line) {
+                if seg.tag & crate::model::paragraph::LineSeg::TAG_IMPLEMENTATION_PROPERTY != 0
+                    && seg.line_height < needed
+                {
+                    seg.line_height = needed;
+                    seg.text_height = seg.text_height.max(needed);
+                    seg.baseline_distance = (f64::from(needed) * 0.85).round() as i32;
+                }
+            }
+        }
+    }
+
     /// HWPX RowBreak 표 셀의 합성 lineSeg를 셀에 저장된 세로 정보와 맞춘다.
     ///
     /// HWPX는 표 셀 안의 문단별 `<hp:linesegarray>`를 생략하면서도, 셀 높이와 마지막
@@ -3514,6 +3673,7 @@ mod validate_linesegs_tests {
