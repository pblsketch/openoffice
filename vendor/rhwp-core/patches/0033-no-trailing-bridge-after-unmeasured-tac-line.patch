 }
 
+/// 본문에 그린 표(셀 안 표가 아닌) 노드의 높이.
+fn drawn_table_height(node: &RenderNode, para_index: usize, control_index: usize) -> Option<f64> {
+    if let RenderNodeType::Table(table) = &node.node_type {
+        return (table.para_index == Some(para_index)
+            && table.control_index == Some(control_index)
+            && table.cell_context.is_none())
+        .then_some(node.bbox.height);
+    }
+    node.children
+        .iter()
+        .find_map(|child| drawn_table_height(child, para_index, control_index))
+}
