+/// 글 없는 host 에 글자처럼 취급 표 하나만 든 저장 줄이 한/글이 잰 줄이 아닌가.
+///
+/// 한/글이 저장한 그런 줄은 표 바깥 상자(`선언 높이 + 바깥 위·아래 여백`)이거나, 선언이
+/// 낡았으면 그린 표에 글자 한 줄 몫까지 더한 높이다(#1835: 그린 95.0px 표의 줄 102.6px —
+/// 한/글 Print 도 그 줄로 다음 문단을 놓는다). 저장 줄이 선언 상자와 다르고 그린 상자보다
+/// 글자 크기 이상 크면 그 줄은 이 표를 잰 값이 아니다(도구가 만든 HWPX 서식: 선언 200HU
+/// 표의 줄 11064HU = 147.5px, 그린 상자 79px). 글자가 줄을 정하는 작은 표는 제외한다.
+/// 조판(`typeset_tac_table`)은 측정 높이로, 그리기는 그린 표 높이로 같은 판정을 한다.
+pub(crate) fn stored_tac_host_line_unmeasured(
+    p: &Paragraph,
+    drawn_height_px: f64,
+    styles: &ResolvedStyleSet,
+    dpi: f64,
+) -> bool {
+    let [Control::Table(table)] = p.controls.as_slice() else {
+        return false;
+    };
+    if !table.common.treat_as_char
+        || table.caption.is_some()
+        || table.common.height >= 0x8000_0000
+        || drawn_height_px <= 1.0
+        || p.text.chars().any(|ch| ch > '\u{001F}' && ch != '\u{FFFC}')
+    {
+        return false;
+    }
+    let Some(line) = p.line_segs.first().filter(|line| {
+        line.tag & crate::model::paragraph::LineSeg::TAG_IMPLEMENTATION_PROPERTY == 0
+    }) else {
+        return false;
+    };
+    let margins = i32::from(table.outer_margin_top) + i32::from(table.outer_margin_bottom);
+    let declared_box = i64::from(table.common.height) + i64::from(margins);
+    let drawn_box = drawn_height_px + hwpunit_to_px(margins, dpi);
+    let font_px = p
+        .char_shapes
+        .first()
+        .and_then(|cs| styles.char_styles.get(cs.char_shape_id as usize))
+        .map_or(0.0, |cs| cs.font_size);
+    (i64::from(line.line_height) - declared_box).abs() > 1
+        && drawn_box >= font_px
+        && hwpunit_to_px(line.line_height, dpi) > drawn_box + font_px + 0.5
+}
+
 /// TAC 표만 품은 빈 host 줄 뒤의 줄간격(px) — 글자 크기로 잰 값. 저장 줄 유무를 따지지
 /// 않는다. 저장 줄 없는 host 는 [`no_ls_tac_table_host_trailing_spacing_px`], 낡은 저장
 /// 줄 host 는 [`stored_tac_table_host_line_outgrown`] 판정 뒤에 이 값을 쓴다.
