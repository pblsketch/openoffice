+    /// 빼면 용지 원점을 옮긴 것과 같다. 표·도형·그림 경로가 저마다 용지 원점을 0 으로
+    /// 두므로 원점 대신 오프셋을 옮긴다. 개체 안의 내용은 개체를 따라간다.
+    fn shift_master_paper_controls(
+        paragraphs: &[Paragraph],
+        shift_hu: i32,
+    ) -> Option<Vec<Paragraph>> {
+        let shifts = |common: &CommonObjAttr| {
+            !common.treat_as_char && common.horz_rel_to == HorzRelTo::Paper
+        };
+        let any = paragraphs.iter().any(|para| {
+            para.controls.iter().any(|ctrl| match ctrl {
+                Control::Table(t) => shifts(&t.common),
+                Control::Shape(s) => shifts(s.common()),
+                Control::Picture(p) => shifts(&p.common),
+                Control::Equation(e) => shifts(&e.common),
+                _ => false,
+            })
+        });
+        if !any {
+            return None;
+        }
+        let mut shifted = paragraphs.to_vec();
+        for para in &mut shifted {
+            for ctrl in &mut para.controls {
+                let common = match ctrl {
+                    Control::Table(t) => &mut t.common,
+                    Control::Shape(s) => s.common_mut(),
+                    Control::Picture(p) => &mut p.common,
+                    Control::Equation(e) => &mut e.common,
+                    _ => continue,
+                };
+                if !shifts(common) {
+                    continue;
+                }
+                let delta = match common.horz_align {
+                    HorzAlign::Left | HorzAlign::Center | HorzAlign::Inside => shift_hu,
+                    HorzAlign::Right | HorzAlign::Outside => -shift_hu,
+                };
+                common.horizontal_offset =
+                    signed_hwpunit(common.horizontal_offset).wrapping_add(delta) as u32;
+            }
+        }
+        Some(shifted)
+    }
