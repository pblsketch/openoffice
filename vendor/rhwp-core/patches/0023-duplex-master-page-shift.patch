+/// 한/글 2024 가 바탕쪽 조합을 HWP 로 저장한 비트와 LIST_HEADER 순서(양쪽 → 짝수 → 홀수).
+#[test]
+fn hancom_master_page_flags_follow_both_even_odd_order() {
+    use HeaderFooterApply::{Both, Even, Odd};
+    let cases: [(u32, &[HeaderFooterApply]); 7] = [
+        (0x2000_0000, &[Both]),
+        (0x4000_0000, &[Even]),
+        (0x8000_0000, &[Odd]),
+        (0x6000_0000, &[Both, Even]),
+        (0xa000_0000, &[Both, Odd]),
+        (0xc000_0000, &[Even, Odd]),
+        (0xe000_0000, &[Both, Even, Odd]),
