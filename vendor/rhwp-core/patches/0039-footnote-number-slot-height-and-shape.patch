+    /// 현재 구역의 각주 모양을 적용한다. 넘긴 속성만 바꾸고, 구역의 각주와 그 안의
+    /// autoNum 자리표시를 새 번호 모양으로 다시 매긴다(미주 모양 적용과 같은 규칙).
+    pub fn apply_footnote_shape_native(
+        &mut self,
+        section_idx: usize,
+        props_json: &str,
+    ) -> Result<String, HwpError> {
+        {
