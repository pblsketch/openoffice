+/// 주석 첫 문단에서 각주·미주 autoNum 자리표시가 놓인 글자 위치, 없으면 -1.
+///
+/// 한/글은 주석 번호를 이 자리표시에서만 그린다. 번호를 글자로 적은 생성기 문서처럼
+/// 자리표시가 없는 주석은 번호가 없다.
+fn note_number_slot(paragraphs: &[crate::model::paragraph::Paragraph]) -> i64 {
+    use crate::model::control::{AutoNumberType, Control};
+    let Some(first) = paragraphs.first() else {
+        return -1;
+    };
+    let positions = first.control_text_positions();
+    first
+        .controls
+        .iter()
+        .enumerate()
+        .find_map(|(index, control)| match control {
+            Control::AutoNumber(auto)
+                if matches!(
+                    auto.number_type,
+                    AutoNumberType::Footnote | AutoNumberType::Endnote
+                ) =>
+            {
+                positions.get(index).map(|&position| position as i64)
+            }
+            _ => None,
+        })
+        .unwrap_or(-1)
+}
