+/// 단을 연 항목과 `host_idx` 의 저장 줄 사이에 **흐름이 따르지 않은 저장 쪽
+/// 경계**(사다리 되감김)가 있는가.
+///
+/// 저장 줄의 vpos 는 한/글이 저장할 때의 쪽 원점에서 잰 값이다. 사다리가 단 안에서
+/// 되감기면 그 뒤 문단의 좌표는 한/글의 **다음 쪽** 원점 기준이고, 지금 단의 위쪽
+/// 끝과는 무관하다. 그 좌표를 물리 쪽 위치로 읽으면 이미 놓인 줄 위에 개체가 겹친다.
+/// 단을 연 항목의 첫 줄(부분 문단은 시작 줄)이 비교 기준이다. 앞 단에서 이어받은
+/// 표 조각의 호스트 줄은 앞 쪽 좌표라 기준에서 뺀다. 되감김의 정의는
+/// [`stored_vpos_rewinds`] 와 같다. 호스트는 자기 첫 저장 줄(개체 앵커)까지만 본다.
+pub(crate) fn column_crossed_unhonored_stored_reset(
+    first: Option<&PageItem>,
+    paragraphs: &[Paragraph],
+    host_idx: usize,
+) -> bool {
+    let (start_para, start_line) = match first {
+        Some(PageItem::FullParagraph { para_index })
+        | Some(PageItem::Table { para_index, .. })
+        | Some(PageItem::Shape { para_index, .. })
+        | Some(PageItem::PartialTable {
+            para_index,
+            is_continuation: false,
+            ..
+        }) => (*para_index, 0),
+        Some(PageItem::PartialParagraph {
+            para_index,
+            start_line,
+            ..
+        }) => (*para_index, *start_line),
+        Some(PageItem::PartialTable {
+            para_index,
+            is_continuation: true,
+            ..
+        }) => (*para_index + 1, 0),
+        Some(PageItem::EndnoteSeparator { .. }) | None => return false,
+    };
+    if start_para > host_idx {
+        return false;
+    }
+    let mut previous: Option<i32> = None;
+    for (index, para) in paragraphs
+        .iter()
+        .enumerate()
+        .take(host_idx + 1)
+        .skip(start_para)
+    {
+        let first_line = if index == start_para { start_line } else { 0 };
+        for seg in para
+            .line_segs
+            .iter()
+            .skip(first_line)
+            .filter(|seg| !is_synthetic_line_seg(seg))
+        {
+            if previous.is_some_and(|prev| seg.vertical_pos < prev && prev > 5000) {
+                return true;
+            }
+            previous = Some(seg.vertical_pos);
+            if index == host_idx {
+                break;
+            }
+        }
+    }
+    false
+}
