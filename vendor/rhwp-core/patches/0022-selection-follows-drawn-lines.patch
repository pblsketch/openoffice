저장 줄(line_segs)이 하나뿐인 긴 문단을 조판이 여러 줄로 다시 나누면
선택 사각형은 저장 줄 수만큼만 만들어져 첫 줄 하나만 칠해졌다. 렌더
트리에서 그 문단 글자 조각의 줄마다 첫 글자 위치를 모아, 저장 줄과
수가 다를 때는 그 줄들로 범위를 나눈다.

각 줄의 범위는 그 줄에 그려진 글자 조각의 처음부터 끝까지이고, 다음 줄 시작을
넘지 않는다. 다음 줄 시작까지로 잡으면 줄 바꿈 글자로 끝나는 표 칸 줄의 오른쪽
끝을 다음 줄에서 찾아 폭이 0이 되었다. 그림을 끼고 한 줄이 TextLine 여럿으로
그려지면 시작이 같은 조각을 한 줄로 합친다. 렌더 트리는 그 문단이 놓인 쪽의
것만 본다(긴 선택에서 문단마다 모든 쪽을 훑지 않는다).

IeumOffice patch onto v0.8.7 (not proposed upstream yet).
---
 src/document_core/queries/cursor_nav.rs | 122 +++++++++++++++++++++++-
 1 file changed, 121 insertions(+), 1 deletion(-)

diff --git a/src/document_core/queries/cursor_nav.rs b/src/document_core/queries/cursor_nav.rs
index 930af00d7..d89714cf2 100644
--- a/src/document_core/queries/cursor_nav.rs
+++ b/src/document_core/queries/cursor_nav.rs
@@ -2240,6 +2240,7 @@ impl DocumentCore {
             }
 
             // 본문 문단이 다른 페이지에 있을 수 있으므로 트리 캐시에 추가
+            let mut para_pages: Option<Vec<u32>> = None;
             if cell_target.is_none() {
                 if let Ok(pp) = self.find_pages_for_paragraph(section_idx, para_idx) {
                     for &pn in &pp {
@@ -2247,11 +2248,71 @@ impl DocumentCore {
                             tree_cache.push((pn, selection_tree(pn)?));
                         }
                     }
+                    para_pages = Some(pp);
                 }
             }
 
+            // 저장 줄(line_segs)과 그려진 줄의 수가 다르면(예: 저장 줄이 하나뿐인 긴
+            // 문단을 조판이 여러 줄로 다시 나눈 경우) 그려진 줄로 사각형을 나눈다.
+            // 저장 줄로 나누면 첫 줄 하나만 칠해진다.
+            // 본문 문단은 그 문단이 놓인 쪽의 트리만 본다. 긴 선택에서 문단마다 모아 둔
+            // 모든 쪽을 훑지 않는다.
+            let rendered = rendered_line_char_ranges(
+                tree_cache
+                    .iter()
+                    .filter(|(pn, _)| para_pages.as_ref().map_or(true, |pages| pages.contains(pn))),
+                |tr| match cell_target {
+                    Some(target) => tr.cell_context.as_ref().is_some_and(|ctx| match target {
+                        SelectionCellTarget::Flat {
+                            parent_para_idx,
+                            control_idx,
+                            cell_idx,
+                        } => flat_cell_ctx_matches(
+                            ctx,
+                            parent_para_idx,
+                            control_idx,
+                            cell_idx,
+                            para_idx,
+                        ),
+                        SelectionCellTarget::Path {
+                            parent_para_idx,
+                            path,
+                        } => path_cell_ctx_matches(ctx, parent_para_idx, path, para_idx),
+                    }),
+                    None => {
+                        tr.section_index == Some(section_idx)
+                            && tr.para_index == Some(para_idx)
+                            && tr.cell_context.is_none()
+                    }
+                },
+            );
+            let use_rendered = rendered.len() > 1 && rendered.len() != line_count;
+            let line_count = if use_rendered {
+                rendered.len()
+            } else {
+                line_count
+            };
+
             for line_idx in 0..line_count {
-                let (line_char_start, line_char_end) = Self::get_line_char_range(para, line_idx);
+                let (line_char_start, line_char_end) = if use_rendered {
+                    // 첫 줄은 문단 처음부터, 마지막 줄은 문단 끝까지 잡아 그려지지
+                    // 않는 앞뒤 글자도 선택에 든다.
+                    let start = if line_idx == 0 {
+                        0
+                    } else {
+                        rendered[line_idx].0
+                    };
+                    // 줄 바꿈 글자처럼 그려지지 않은 줄 끝 글자는 범위에서 뺀다. 줄
+                    // 범위가 다음 줄과 겹치면(빈 조각이 앞 글자 자리를 가리키는 줄)
+                    // 다음 줄 시작에서 끊는다.
+                    let end = match rendered.get(line_idx + 1) {
+                        Some(next) => rendered[line_idx].1.min(next.0),
+                        None => char_count,
+                    };
+                    (start, end)
+                } else {
+                    Self::get_line_char_range(para, line_idx)
+                };
                 let range_start = sel_start.max(line_char_start);
                 let range_end = sel_end.min(line_char_end);
                 if range_start >= range_end {
@@ -2365,6 +2426,65 @@ impl DocumentCore {
 /// 지정할 수 없다 — `path.len() == 1` 가드 없이 `path[0]` 만 비교하면, 중첩
 /// 표 내부(depth>=2) run 이 그 중첩 표를 품은 바깥 셀과 동일한 `path[0]` 을
 /// 가져 잘못 매칭된다(같은 클래스의 이미 고친 `cursor_rect.rs` 버그와 동형).
+/// 렌더 트리에 그려진 한 문단의 줄마다 (첫 글자, 마지막 글자 다음) 위치를 첫 글자
+/// 순으로 돌려준다. 각 TextRun은 가장 가까운 조상 TextLine에 속하고, 줄의 범위는
+/// 그 줄에 든 문단 글자 조각의 `char_start`가 가장 작은 곳부터 조각 끝이 가장 큰
+/// 곳까지다. 줄 바꿈 글자처럼 그려지지 않는 글자는 범위에 들지 않는다. 쪽·단
+/// 순서와 무관하게 글자 순서로 정렬되므로 여러 쪽·단에 걸친 문단도 그대로 이어진다.
+fn rendered_line_char_ranges<'a>(
+    trees: impl Iterator<Item = &'a (u32, crate::renderer::render_tree::PageRenderTree)>,
+    owns: impl Fn(&crate::renderer::render_tree::TextRunNode) -> bool,
+) -> Vec<(usize, usize)> {
+    use crate::renderer::render_tree::{RenderNode, RenderNodeType};
+
+    fn visit(
+        node: &RenderNode,
+        line: Option<&mut Option<(usize, usize)>>,
+        owns: &dyn Fn(&crate::renderer::render_tree::TextRunNode) -> bool,
+        ranges: &mut Vec<(usize, usize)>,
+    ) {
+        if let RenderNodeType::TextLine(_) = node.node_type {
+            let mut range: Option<(usize, usize)> = None;
+            for child in &node.children {
+                visit(child, Some(&mut range), owns, ranges);
+            }
+            if let Some(range) = range {
+                ranges.push(range);
+            }
+            return;
+        }
+        let mut line = line;
+        if let RenderNodeType::TextRun(ref tr) = node.node_type {
+            if let (Some(cs), Some(slot)) = (tr.char_start, line.as_deref_mut()) {
+                if owns(tr) {
+                    let end = cs + tr.text.chars().count();
+                    *slot = Some(slot.map_or((cs, end), |(s, e)| (s.min(cs), e.max(end))));
+                }
+            }
+        }
+        for child in &node.children {
+            visit(child, line.as_deref_mut(), owns, ranges);
+        }
+    }
+
+    let mut ranges = Vec::new();
+    for (_, tree) in trees {
+        visit(&tree.root, None, &owns, &mut ranges);
+    }
+    // 한 줄이 개체를 끼고 여러 TextLine으로 그려지면 같은 시작이 여럿 나온다(빈
+    // 조각만 든 쪽은 끝도 시작과 같다). 시작이 같으면 한 줄로 보고 끝은 큰 쪽을 쓴다.
+    ranges.sort_unstable();
+    ranges.dedup_by(|later, kept| {
+        if later.0 == kept.0 {
+            kept.1 = kept.1.max(later.1);
+            true
+        } else {
+            false
+        }
+    });
+    ranges
+}
