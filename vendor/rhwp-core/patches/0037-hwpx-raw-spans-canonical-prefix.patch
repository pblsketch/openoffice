+/// 원본 구간을 그대로 다시 쓸 때 쓰는 OWPML 이름공간별 표준 접두사.
+/// 직렬화기가 `hh:head`·`hs:sec` 등의 뿌리 요소에 선언하는 것과 같다.
+const CANONICAL_PREFIXES: &[(&str, &str)] = &[
+    ("http://www.hancom.co.kr/hwpml/2011/app", "ha"),
+    ("http://www.hancom.co.kr/hwpml/2011/paragraph", "hp"),
+    ("http://www.hancom.co.kr/hwpml/2016/paragraph", "hp10"),
+    ("http://www.hancom.co.kr/hwpml/2011/section", "hs"),
+    ("http://www.hancom.co.kr/hwpml/2011/core", "hc"),
+    ("http://www.hancom.co.kr/hwpml/2011/head", "hh"),
+    ("http://www.hancom.co.kr/hwpml/2011/history", "hhs"),
+    ("http://www.hancom.co.kr/hwpml/2011/master-page", "hm"),
+];
+
+/// 문서 뿌리 요소가 선언한 이름공간: (접두사, URI). 기본 이름공간은 접두사 "".
+fn root_namespaces(xml: &str) -> Vec<(String, String)> {
+    let mut rest = xml;
+    // XML 선언·주석·처리 지시를 건너 첫 요소의 여는 태그를 찾는다.
+    let tag = loop {
+        let Some(start) = rest.find('<') else {
+            return Vec::new();
+        };
+        rest = &rest[start..];
+        if rest.starts_with("<?") || rest.starts_with("<!") {
+            let Some(end) = rest.find('>') else {
+                return Vec::new();
+            };
+            rest = &rest[end + 1..];
+            continue;
+        }
+        let Some(end) = rest.find('>') else {
+            return Vec::new();
+        };
+        break &rest[..end];
+    };
+    let mut out = Vec::new();
+    let mut at = 0;
+    while let Some(found) = tag[at..].find("xmlns") {
+        let name_start = at + found + "xmlns".len();
+        let after = &tag[name_start..];
+        let (prefix, after) = match after.strip_prefix(':') {
+            Some(named) => {
+                let len = named
+                    .find(|c: char| c == '=' || c.is_whitespace())
+                    .unwrap_or(named.len());
+                (named[..len].to_string(), &named[len..])
+            }
+            None => (String::new(), after),
+        };
+        let after = after.trim_start().strip_prefix('=').map(str::trim_start);
+        let Some(value) = after else {
+            at = name_start;
+            continue;
+        };
+        let Some(quote) = value.chars().next().filter(|c| *c == '"' || *c == '\'') else {
+            at = name_start;
+            continue;
+        };
+        let Some(len) = value[1..].find(quote) else {
+            break;
+        };
+        out.push((prefix, value[1..1 + len].to_string()));
+        at = tag.len() - value.len() + 1 + len;
+    }
+    out
+}
+
+/// 원본 XML에서 잘라 둔 요소 구간을 다른 문서 안에 그대로 다시 쓸 수 있게, 요소 이름의
+/// 접두사를 이름공간별 표준 접두사로 바꾼다. 원본 뿌리 요소의 선언으로 접두사를 풀고, 이미
+/// 표준 접두사뿐이면 구간을 그대로 돌려준다(한컴이 쓴 문서). 다른 도구가 다른 접두사로 쓴
+/// 문서에서 그대로 옮기면, 저장한 XML에 선언 없는 접두사가 남아 한컴 한글이 파일을 열지
+/// 못한다. 풀 수 없는 접두사, 구간 안의 이름공간 선언, 접두사 붙은 속성이 있으면 `None`:
+/// 구간을 버리고 모델로 다시 쓰게 한다.
+pub fn canonical_prefix_span(xml: &str, span: &str) -> Option<String> {
+    let declared = root_namespaces(xml);
+    let canonical = |prefix: &str| -> Option<&'static str> {
+        let uri = declared
+            .iter()
+            .rev()
+            .find(|(p, _)| p == prefix)
+            .map(|(_, u)| u.as_str())?;
+        CANONICAL_PREFIXES
+            .iter()
+            .find(|(u, _)| *u == uri)
+            .map(|(_, p)| *p)
+    };
+    let mut out = String::with_capacity(span.len());
+    let mut rest = span;
+    let mut changed = false;
+    while let Some(open) = rest.find('<') {
+        out.push_str(&rest[..open]);
+        rest = &rest[open..];
+        if rest.starts_with("<!--") {
+            let end = rest.find("-->")? + 3;
+            out.push_str(&rest[..end]);
+            rest = &rest[end..];
+            continue;
+        }
+        if rest.starts_with("<![CDATA[") {
+            let end = rest.find("]]>")? + 3;
+            out.push_str(&rest[..end]);
+            rest = &rest[end..];
+            continue;
+        }
+        if rest.starts_with("<?") || rest.starts_with("<!") {
+            let end = rest.find('>')? + 1;
+            out.push_str(&rest[..end]);
+            rest = &rest[end..];
+            continue;
+        }
+        let closing = rest.starts_with("</");
+        let name_at = if closing { 2 } else { 1 };
+        let tag_end = rest.find('>')?;
+        let tag = &rest[..=tag_end];
+        let name_len = tag[name_at..]
+            .find(|c: char| c.is_whitespace() || c == '/' || c == '>')
+            .unwrap_or(tag.len() - name_at);
+        let name = &tag[name_at..name_at + name_len];
+        let attrs = &tag[name_at + name_len..];
+        if attrs.contains("xmlns") {
+            return None;
+        }
+        // 속성 이름의 접두사(xml: 말고)는 이 함수가 풀지 않는다
+        let mut in_value: Option<char> = None;
+        let mut token = String::new();
+        for c in attrs.chars() {
+            match in_value {
+                Some(q) if c == q => in_value = None,
+                Some(_) => {}
+                None if c == '"' || c == '\'' => in_value = Some(c),
+                None if c == '=' => {
+                    let attr = token.trim();
+                    if attr.contains(':') && !attr.starts_with("xml:") {
+                        return None;
+                    }
+                    token.clear();
+                }
+                None if c.is_whitespace() => token.clear(),
+                None => token.push(c),
+            }
+        }
+        let (prefix, local) = match name.split_once(':') {
+            Some((p, l)) => (p, l),
+            None => ("", name),
+        };
+        let wanted = canonical(prefix)?;
+        if wanted != prefix {
+            changed = true;
+        }
+        out.push_str(&rest[..name_at]);
+        out.push_str(wanted);
+        out.push(':');
+        out.push_str(local);
+        out.push_str(attrs);
+        rest = &rest[tag_end + 1..];
+    }
+    out.push_str(rest);
+    Some(if changed { out } else { span.to_string() })
+}
