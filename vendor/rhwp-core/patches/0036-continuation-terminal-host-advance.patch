@@ -27,3 +27,35 @@ pub(crate) fn stored_unconsumed_rowbreak_host_advance_hu(
         next_para,
     )
 }
+
+/// 이어지는 쪽에서 끝나는 분할 표 뒤의 저장 호스트 줄 전진은 그 쪽의 저장 다음 줄이
+/// 같은 자리를 증언할 때만 실제 흐름이다.
+///
+/// `stored_unconsumed_rowbreak_host_advance_hu` 의 증거(`next.vpos - host.vpos == 전진량`)는
+/// 표가 접힌 사다리일 뿐, 끝 조각이 놓인 쪽의 좌표를 말하지 않는다. 한글은 다음 줄의 저장
+/// 위치가 그 쪽에서 `조각 흐름 끝 + 전진량` 일 때만 줄 공간을 남긴다(KTX 26쪽: 문단 407
+/// vpos 37878 = 조각 끝 + 2400). 기계 반복 양식처럼 다음 줄이 다른 쪽 좌표를 담으면 한글은
+/// 다음 문단을 조각 흐름 끝(바깥 아래 여백 뒤)에서 바로 시작한다 — 한글 2024 인쇄,
+/// issue2439_repeat_table_overlap 3·4쪽.
+pub(crate) fn continuation_successor_confirms_host_advance(
+    next_para: Option<&Paragraph>,
+    flow_end_in_column_px: f64,
+    next_spacing_before_px: f64,
+    advance_hu: i32,
+    dpi: f64,
+) -> bool {
+    let Some(next_line) = next_para.and_then(|next| {
+        next.line_segs
+            .iter()
+            .find(|seg| seg.tag & 0x80000000 == 0 && seg.line_height > 0)
+    }) else {
+        return false;
+    };
+    if !flow_end_in_column_px.is_finite() || !next_spacing_before_px.is_finite() || dpi <= 0.0 {
+        return false;
+    }
+    let units_per_px = 7200.0 / dpi;
+    let expected = ((flow_end_in_column_px + next_spacing_before_px) * units_per_px).round() as i64
+        + i64::from(advance_hu);
+    (i64::from(next_line.vertical_pos) - expected).abs() as f64 <= units_per_px
+}
