+}
+/// [ieum 0026] 셀 영역의 경계가 시작하는 칸이 없는 행에 걸려도 HWPX 저장은 실패하지 않는다.
+/// 상위는 여기서 저장 전체를 거절했다. 0.8.7-ieum 처럼 그 영역을 그 행을 덮는 위쪽 남은
+/// 행으로 넓혀 저장한다. 빠진 행은 제 높이가 없으므로 칸·글은 그대로이고 영역만 넓어진다.
+#[test]
+fn row_projection_widens_a_zone_on_a_dropped_row() {
     let mut c = merged_native();
     let ci = root(&c).0;
     let Control::Table(t) = &mut c.document_mut().sections[0].paragraphs[0].controls[ci] else {
@@ -1806,11 +1812,38 @@ fn row_projection_rejects_ambiguous_ids_and_physical_holes() {
         end_col: 1,
         border_fill_id: t.border_fill_id,
     });
-    assert!(c
-        .export_hwpx_native()
-        .unwrap_err()
-        .to_string()
-        .contains("빈 논리 행"));
+    let before = table_topology(&c);
+    let text_before = text(&c.document().sections[0].paragraphs);
+    let bytes = c.export_hwpx_native().unwrap();
+    assert_xml_rows(&bytes, 1);
+    let part = zip_part(&bytes, "Contents/section0.xml");
+    assert!(
+        std::str::from_utf8(&part)
+            .unwrap()
+            .contains(r#"<hp:cellzone startRowAddr="0" startColAddr="0" endRowAddr="0" endColAddr="1""#),
+        "영역은 남은 0행으로 넓어진다"
+    );
+    let zones = |d: &DocumentCore| {
+        root(d)
+            .1
+            .zones
+            .iter()
+            .map(|z| (z.start_row, z.end_row, z.start_col, z.end_col))
+            .collect::<Vec<_>>()
+    };
+    // rhwp 는 곁 파일로 원래 2행 격자를 되살린다. 영역은 넓어진 채(0~1행)다.
+    let restored = DocumentCore::from_bytes(&bytes).unwrap();
+    assert_eq!(table_topology(&restored), before);
+    assert_eq!(zones(&restored), vec![(0, 1, 0, 1)]);
+    assert_eq!(
+        text(&restored.document().sections[0].paragraphs),
+        text_before
+    );
+    // 곁 파일이 없으면(한컴이 보는 표) 1행 표의 0행 영역이다.
+    let plain = DocumentCore::from_bytes(&change_part(&bytes, ROW_GRID, None)).unwrap();
+    assert_eq!(root(&plain).1.row_count, 1);
+    assert_eq!(zones(&plain), vec![(0, 0, 0, 1)]);
+    assert_eq!(text(&plain.document().sections[0].paragraphs), text_before);
 }
 
 fn topology_scope_load() -> (DocumentCore, usize) {
