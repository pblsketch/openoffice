                         && matches!(
                             placement.flow,
@@ -10152,6 +10347,15 @@ impl LayoutEngine {
                     if owner == item_para
                         && placement.flow == super::float_placement::ParagraphFloatFlow::NextLine
                     {
+                        // 조판과 같다 — 글 있는 문단은 표 아래끝에 뒤 간격을 두지 않는다.
+                        let spacing_after = if paragraphs
+                            .get(owner)
+                            .is_some_and(para_has_non_whitespace_text)
