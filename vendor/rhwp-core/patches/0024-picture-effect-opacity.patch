 pub const LEGACY_IMAGE_WATERMARK_OPACITY: f64 = 0.17;
 
+/// 한컴 "워터마크 효과"가 넣는 밝기·대비 값(밝기 70 · 대비 −50)인지.
+///
+/// [`LEGACY_IMAGE_WATERMARK_OPACITY`] 반투명 합성은 이 값에만 쓴다. 저장 파일에는
+/// 워터마크 비트가 없고, 한컴은 "워터마크 효과"를 켜면 이 두 값을 넣는다. 종전에는
+/// "밝기·대비가 둘 다 0 이 아니면 워터마크"로 보아, 밝기·대비를 조금 바꾼 그림까지
+/// 반투명으로 그렸다. 회색조 + 밝기 −4 · 대비 −25 인 칸 배경 막대를 한컴 한글 2024 는
+/// 불투명하게, 밝기·대비만 적용해 그린다(원본 255 → 213, 125 → 115 — SVG
+/// `ensure_brightness_contrast_filter` 의 선형식을 sRGB 값에 건 결과와 같다). 엔진은 같은 값에 투명도
+/// 0.17 을 더 얹어 막대가 거의 보이지 않았다.
+///
+/// 인자 순서를 가리지 않는다. HWP5 그림 레코드(`SC_PICTURE`)는 두 칸을 대비·밝기
+/// 순으로 저장하고 IR 이 그 순서를 그대로 담는다(`hwpx_to_hwp` 의
+/// `normalize_picture_geometry_for_hwp` 참조). 그래서 `.hwp` 그림의 [`ImageNode`] 는
+/// 이 프리셋을 `(-50, 70)` 으로, `.hwpx` 그림과 채우기 그림은 `(70, -50)` 으로 나른다.
+pub fn is_hancom_watermark_preset(a: i8, b: i8) -> bool {
+    matches!((a, b), (70, -50) | (-50, 70))
+}
+
 /// 한컴 "워터마크 효과" 프리셋(밝기 70 · 대비 −50)인지.
 ///
 /// [#6895] 인자는 **화면 순서**다. 종전에는 이진 저장 순서(`-50, 70`)로 적혀 있었는데,
@@ -807,6 +825,11 @@ impl PageBackgroundImage {
         self.brightness != 0 && self.contrast != 0
     }
 
+    /// 반투명 합성 대상인 한컴 워터마크 값인지 ([`is_hancom_watermark_preset`]).
+    pub fn is_watermark_preset(&self) -> bool {
+        is_hancom_watermark_preset(self.brightness, self.contrast)
+    }
+
     pub fn is_real_picture_watermark_tone_preset(&self) -> bool {
         // 이 구조체는 이진 저장 순서를 담으므로 화면 순서로 바꿔 넘긴다(#6895).
         let (bright, contrast) = self.display_brightness_contrast();
@@ -1512,6 +1535,11 @@ impl ImageNode {
         self.brightness != 0 && self.contrast != 0
     }
 
+    /// 반투명 합성 대상인 한컴 워터마크 값인지 ([`is_hancom_watermark_preset`]).
+    pub fn is_watermark_preset(&self) -> bool {
+        is_hancom_watermark_preset(self.brightness, self.contrast)
+    }
+
     pub fn is_real_picture_watermark_tone_preset(&self) -> bool {
         // `ImageNode` 의 두 필드는 이미 화면 순서다(#6895).
         is_real_picture_watermark_tone_preset(self.effect, self.brightness, self.contrast)
