+/// 회색조 칸 배경 그림의 밝기·대비를 조금 바꾼 것(밝기 −4 · 대비 −25)은 워터마크가
+/// 아니다. 한컴 한글 2024 는 밝기·대비만 적용해 불투명하게 그린다 — 반투명 합성이
+/// 얹히면 머리말 장식 막대가 거의 보이지 않는다.
+#[test]
+fn test_image_node_mild_brightness_contrast_stays_opaque() {
+    let mut image = ImageNode::new(1, Some(make_minimal_tiff_2x2()));
+    image.fill_mode = Some(ImageFillMode::FitToSize);
+    image.effect = crate::model::image::ImageEffect::GrayScale;
+    image.brightness = -4;
+    image.contrast = -25;
+    let bbox = BoundingBox::new(10.0, 20.0, 100.0, 5.0);
+    let mut renderer = SvgRenderer::new();
+    renderer.begin_page(200.0, 100.0);
+
+    renderer.render_image_node(&image, &bbox);
+
+    let output = renderer.output();
+    assert!(
+        output.contains("rhwp-img-grayscale"),
+        "회색조 효과는 그대로 적용한다: {output}"
+    );
+    assert!(
+        output.contains("rhwp-img-bc-b-4c-25"),
+        "밝기·대비 필터는 그대로 적용한다: {output}"
+    );
+    assert!(
+        !output.contains("<g opacity="),
+        "워터마크 값이 아닌 밝기·대비에 반투명 합성을 얹으면 안 된다: {output}"
+    );
+}
+
+/// 한컴 워터마크 값(밝기 70 · 대비 −50)은 종전대로 반투명 합성한다. `.hwp` 그림
+/// 레코드는 두 값을 대비·밝기 순으로 담아 `(-50, 70)` 으로 오므로 그 순서도 같다.
+#[test]
+fn test_image_node_watermark_preset_keeps_legacy_opacity_in_both_orders() {
+    for (brightness, contrast) in [(70, -50), (-50, 70)] {
+        let mut image = ImageNode::new(1, Some(make_minimal_tiff_2x2()));
+        image.fill_mode = Some(ImageFillMode::FitToSize);
+        image.effect = crate::model::image::ImageEffect::GrayScale;
+        image.brightness = brightness;
+        image.contrast = contrast;
+        let bbox = BoundingBox::new(10.0, 20.0, 100.0, 50.0);
+        let mut renderer = SvgRenderer::new();
+        renderer.begin_page(200.0, 100.0);
+
+        renderer.render_image_node(&image, &bbox);
+
+        let output = renderer.output();
+        assert!(
+            output.contains(&format!(
+                "<g opacity=\"{}\">",
+                LEGACY_IMAGE_WATERMARK_OPACITY
+            )),
+            "워터마크 값 ({brightness}, {contrast}) 은 반투명 합성을 유지한다: {output}"
+        );
+    }
+}
+
+/// 쪽 배경도 같다. `PageBackgroundImage` 는 이진 저장 순서(대비, 밝기)를 담는다.
+#[test]
+fn test_page_background_mild_brightness_contrast_stays_opaque() {
+    let png = bmp_bytes_to_png_bytes(&make_minimal_bmp_2x2()).expect("BMP->PNG 변환 실패");
+    let image = PageBackgroundImage {
+        data: png,
+        fill_mode: ImageFillMode::FitToSize,
+        brightness: -25,
+        contrast: -4,
+        effect: crate::model::image::ImageEffect::GrayScale,
+    };
+    let bbox = BoundingBox::new(10.0, 20.0, 100.0, 50.0);
+    let mut renderer = SvgRenderer::new();
+    renderer.begin_page(200.0, 100.0);
+
+    renderer.render_page_background_image(&image, &bbox);
+
+    let output = renderer.output();
+    assert!(output.contains("rhwp-img-bc-b-4c-25"), "{output}");
+    assert!(
+        !output.contains("<g opacity="),
+        "워터마크 값이 아닌 쪽 배경에 반투명 합성을 얹으면 안 된다: {output}"
+    );
+}
+
