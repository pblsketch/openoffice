     let mut renderer = SvgRenderer::new();
@@ -1167,6 +1250,11 @@ fn test_brightness_contrast_filter_nonzero_adds_defs() {
     assert!(def.contains(&format!("id=\"{}\"", id)));
     assert!(def.contains("<feComponentTransfer>"));
     assert!(def.contains("feFuncR"));
+    // 한컴의 밝기·대비는 sRGB 값에 거는 선형식과 같다(기본 linearRGB 면 옅어진다).
+    assert!(
+        def.contains("color-interpolation-filters=\"sRGB\""),
+        "{def}"
+    );
 }
 
