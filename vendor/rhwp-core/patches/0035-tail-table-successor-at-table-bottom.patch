diff --git a/src/renderer/layout.rs b/src/renderer/layout.rs
index 2ec8e684c01656bdc1f01dc6e1502a3ada6cc8ae..5eb5ecdce76333d98d6bf5a909a514d493f917a7 100644
--- a/src/renderer/layout.rs
+++ b/src/renderer/layout.rs
@@ -16330,10 +16330,28 @@ impl LayoutEngine {
         // A complete stored object frame owns the successor's line origin.
         // Consume that same accepted result after painting; generic empty-host
         // line advances above must not replace it with a separate cursor.
+        // The origin belongs to the next paragraph: while items of this host
+        // still follow in its column (#6950 paints a text tail table before its
+        // own lines), the host's completion consumes it instead.
         if let Some(origin) = ctx
             .paragraph_float_placements
             .get(&(para_index, control_index))
             .and_then(|placement| placement.stored_successor_line_origin)
+            .filter(|_| {
+                !page_content.column_contents.iter().any(|cc| {
+                    cc.items
+                        .iter()
+                        .position(|it| {
+                            matches!(it, PageItem::Table { para_index: pi, control_index: ci, .. }
+                                if *pi == para_index && *ci == control_index)
+                        })
+                        .is_some_and(|at| {
+                            cc.items[at + 1..]
+                                .iter()
+                                .any(|it| it.para_index() == para_index)
+                        })
+                })
+            })
         {
             y_offset = col_area.y + origin;
         }
