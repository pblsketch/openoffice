{
  "name": "@genoffice/hwp",
  "productName": "GenOffice HWP",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "HWP/HWPX editor module: hosts the rhwp-studio editor in a shell tab and owns open/save",
  "main": "out/main/index.js",
  "scripts": {
    "studio": "node scripts/build-studio.mjs",
    "dev": "npm run studio && electron-vite dev",
    "dev:renderer": "npm run studio && vite --config vite.renderer.config.ts",
    "build": "npm run studio && electron-vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@genoffice/agent-core": "*",
    "@genoffice/ai-provider": "*",
    "@genoffice/doc-rules": "*",
    "@genoffice/electron-utils": "*",
    "@genoffice/file-parse": "*",
    "@genoffice/i18n": "*",
    "@genoffice/project-store": "*",
    "@genoffice/ui": "*",
    "@noble/hashes": "^2.2.0",
    "@rhwp/core": "file:../../vendor/rhwp-core",
    "@rhwp/editor": "0.8.7",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "canvaskit-wasm": "0.42.0",
    "cfb": "^1.2.2",
    "electron": "^43.7.6",
    "electron-vite": "^5.0.0",
    "jsdom": "^28.0.0",
    "jszip": "^3.10.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.11"
  },
  "author": "GenOffice"
}
