{
  "name": "@genoffice/epub-engine",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "EPUB engine: open books behind the zip gate, map editable blocks with their source ranges, save by range replacement only, and build translated or bilingual books",
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@genoffice/pdf-structure": "*",
    "@genoffice/zip-gate": "*",
    "jszip": "^3.10.1",
    "parse5": "^8.0.1",
    "saxes": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
